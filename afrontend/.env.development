# Development env (committed). Loaded automatically by Vite when running
# `npm run dev`. Override locally with `.env.development.local` (gitignored)
# if you need to point dev at the deployed backend instead of localhost.

# Local backend started via `npm run dev` inside ../backend.
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_API_URL=http://localhost:5000
