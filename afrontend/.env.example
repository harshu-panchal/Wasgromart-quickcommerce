# Copy to `.env`, `.env.development`, or `.env.production` and fill values.
# Anything prefixed with VITE_ is EMBEDDED INTO THE CLIENT BUNDLE — never put
# server-side secrets here.

# ---- API ----
# Absolute base URL of the backend REST API. Required in production builds.
# Examples:
#   Local dev   : http://localhost:5000/api/v1
#   Production  : https://api.wasgromart.com/api/v1
VITE_API_BASE_URL=

# Optional. Base origin used for socket.io / static asset URLs. If omitted,
# getSocketBaseURL() derives it from VITE_API_BASE_URL by stripping /api/vN.
VITE_API_URL=

# ---- Firebase (web push + auth) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# REQUIRED for web FCM token registration. Generate in Firebase Console →
# Project Settings → Cloud Messaging → Web configuration → "Generate key pair".
# Leaving this blank causes `messaging/token-subscribe-failed` 401 errors.
VITE_FIREBASE_VAPID_KEY=

# ---- Google Maps ----
VITE_GOOGLE_MAPS_API_KEY=
