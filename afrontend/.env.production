# Production build env (committed). Loaded automatically by Vite when running
# `npm run build` / `vite build`. Do NOT put secrets in here that you wouldn't
# want shipped to the browser — Vite inlines every VITE_* variable into the
# bundle. Real secrets must stay on the backend.

# Real production API. The frontend on Hostinger has no /api/v1 reverse proxy,
# so this MUST be an absolute URL pointing at the backend domain.
VITE_API_BASE_URL=https://api.wasgromart.com/api/v1

# Socket.io / websocket base. Derived automatically by getSocketBaseURL() if
# left blank, but you can override here if your socket origin ever differs
# from the API origin.
VITE_API_URL=https://api.wasgromart.com
