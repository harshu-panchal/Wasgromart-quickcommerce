# ---------------------------------------------------------------------------
# Backend environment configuration (example)
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# CRITICAL in production. Enables Express optimizations, the Socket.IO
# production CORS branch, and suppresses high-volume debug logging.
NODE_ENV=production

# Hostinger / cPanel shared hosting — auto-detected from ~/domains/.../nodejs
# paths, or set explicitly. Applies smaller Mongo pool, no in-app gzip, etc.
SHARED_HOSTING=true

# Cap Node heap on shared hosting (set in Hostinger "Environment variables" panel).
# Typical shared plans allow ~512 MB; leave headroom for native addons (bcrypt, etc.).
# NODE_OPTIONS=--max-old-space-size=384

# Set true to temporarily re-enable verbose debug logs in production.
LOG_DEBUG=false

# Secret key required to access GET /debug-sockets in production
# DEBUG_ENDPOINT_KEY=your-random-secret

# Server — on Hostinger, PORT is assigned by the panel; do not hardcode.
PORT=5000

# Comma-separated production frontend origins (required for Socket.IO CORS).
FRONTEND_URL=https://www.wasgromart.com,https://wasgromart.com

# Public API URL (used for upload URLs returned to clients)
API_PUBLIC_URL=https://api.wasgromart.com

# Uploads live OUTSIDE nodejs/ on Hostinger so deploys don't wipe files.
# UPLOAD_DIR=/home/u123456789/domains/wasgromart.com/uploads

# MongoDB (Atlas M0 free tier works; keep pool small on shared hosting)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# Shared-hosting defaults: max=10 min=1. Only raise if you upgrade to VPS.
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=1
MONGO_CONNECT_MAX_ATTEMPTS=10

# Per-IP API rate limit (requests per minute). 300 is safe on shared hosting.
RATE_LIMIT_MAX=300

# Auth
JWT_SECRET=<generate-a-strong-secret>
JWT_REFRESH_SECRET=<generate-a-strong-secret>
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>

# Default admin bootstrap
DEFAULT_ADMIN_MOBILE=<mobile>
DEFAULT_ADMIN_EMAIL=<email>
DEFAULT_ADMIN_PASSWORD=<password>
DEFAULT_ADMIN_ROLE=Super Admin
DEFAULT_OTP=9999

# OTP / SMS
TWOFACTOR_API_KEY=<key>
OTP_EXPIRY_MINUTES=5
OTP_PROVIDER=2FACTOR_VOICE
USE_MOCK_OTP=false
SMS_INDIA_HUB_USERNAME=<username>
SMS_INDIA_HUB_API_KEY=<key>
SMS_INDIA_HUB_SENDER_ID=<sender-id>
SMS_INDIA_HUB_DLT_TEMPLATE_ID=<template-id>

# Firebase Admin (service account JSON as a single-line string)
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account", ...}'

# Razorpay
RAZORPAY_KEY_ID=<key-id>
RAZORPAY_KEY_SECRET=<key-secret>
RAZORPAY_WEBHOOK_SECRET=<webhook-secret>
